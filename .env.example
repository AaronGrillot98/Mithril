# ---------------------------------------------------------------------------
# Proxy
# ---------------------------------------------------------------------------

# Upstream LLM provider — what Mithril forwards safe requests to.
# Examples:
#   OpenAI:        https://api.openai.com/v1
#   Anthropic:     https://api.anthropic.com/v1
#   Ollama:        http://localhost:11434/v1
#   Together AI:   https://api.together.xyz/v1
MITHRIL_UPSTREAM_URL=https://api.openai.com/v1

# Bind address and port for the proxy.
MITHRIL_HOST=0.0.0.0
MITHRIL_PORT=8080

# What to do when a request is flagged: "block" (return 403) or "log" (forward but record).
MITHRIL_MODE=block

# Minimum confidence (0.0 - 1.0) to trigger blocking.
MITHRIL_THRESHOLD=0.7

# SQLite database for event logging.
MITHRIL_DB_PATH=mithril.db

# ---------------------------------------------------------------------------
# LLM judge (v0.2) — second-opinion model for ambiguous prompts.
# Disabled by default. When on, the judge only runs when the regex score
# falls between LOW_THRESHOLD and HIGH_THRESHOLD — typically <5% of traffic.
# ---------------------------------------------------------------------------

MITHRIL_JUDGE_ENABLED=false

# Provider. "openai_compat" speaks /v1/chat/completions and works with OpenAI,
# Together, Groq, Fireworks, Ollama, vLLM, LM Studio, llama.cpp, and the
# Anthropic OpenAI-compatibility shim.
MITHRIL_JUDGE_PROVIDER=openai_compat
MITHRIL_JUDGE_BASE_URL=https://api.openai.com/v1
MITHRIL_JUDGE_MODEL=gpt-4o-mini
MITHRIL_JUDGE_API_KEY=

# Ambiguous zone — judge runs only when LOW < score < HIGH.
MITHRIL_JUDGE_LOW_THRESHOLD=0.2
MITHRIL_JUDGE_HIGH_THRESHOLD=0.9

# What to do if the judge errors out: "open" = trust regex, "closed" = block.
MITHRIL_JUDGE_FAIL_MODE=open

MITHRIL_JUDGE_TIMEOUT=5.0

# ---------------------------------------------------------------------------
# Output scanning (v0.4) — scan the LLM's response for PII / secrets / leaks
# before forwarding it back to the client. Disabled by default.
# ---------------------------------------------------------------------------

MITHRIL_OUTPUT_SCAN_ENABLED=false

# What to do when output triggers a rule:
#   block   — return HTTP 403 with structured Mithril error envelope.
#   redact  — pass response through but replace matched spans with
#             [REDACTED:<rule_id>] markers.
#   log     — pass response through unchanged; just record the event.
MITHRIL_OUTPUT_SCAN_MODE=redact
MITHRIL_OUTPUT_SCAN_THRESHOLD=0.7

# Redaction marker. Available substitutions: {rule_id} {detector} {severity}.
MITHRIL_OUTPUT_SCAN_MARKER=[REDACTED:{rule_id}]

# Streaming-output scan algorithm:
#   incremental — forward chunks as they arrive (preserves streaming UX);
#                 scan in the background. Block mode emits a final error
#                 frame and closes on the first hit. Log mode records
#                 without altering the stream. Redact mode falls back to
#                 `buffer` (true streaming redaction is on the v0.6 roadmap).
#   buffer      — collect the entire SSE stream, scan as a whole, re-emit.
#                 Sacrifices streaming UX for full redaction support.
MITHRIL_OUTPUT_SCAN_STREAM_MODE=incremental

# ---------------------------------------------------------------------------
# Embedding similarity layer (v0.5) — third defense alongside regex + judge.
# Off by default. Requires the optional [embeddings] extra:
#     pip install mithril-llm[embeddings]
# ---------------------------------------------------------------------------

MITHRIL_EMBEDDING_ENABLED=false
MITHRIL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MITHRIL_EMBEDDING_THRESHOLD=0.80
# Empty → use the bundled mithril/embeddings/corpus.jsonl (50 canonical jailbreaks).
MITHRIL_EMBEDDING_CORPUS_PATH=

# Cap upstream response size when output scanning is enabled. Default 4 MiB.
# A malicious or buggy upstream sending an unbounded stream could otherwise
# OOM the proxy. Returns HTTP 502 {"error": {"type": "response_too_large"}}
# if exceeded.
MITHRIL_MAX_RESPONSE_BYTES=4194304
