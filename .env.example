# ---------------------------------------------------------------------------
# Proxy
# ---------------------------------------------------------------------------

# Upstream LLM provider — what Mithril forwards safe requests to.
# Examples:
#   OpenAI:        https://api.openai.com/v1
#   Anthropic:     https://api.anthropic.com/v1
#   Ollama:        http://localhost:11434/v1
#   Together AI:   https://api.together.xyz/v1
MITHRIL_UPSTREAM_URL=https://api.openai.com/v1

# Bind address and port for the proxy.
MITHRIL_HOST=0.0.0.0
MITHRIL_PORT=8080

# What to do when a request is flagged: "block" (return 403) or "log" (forward but record).
MITHRIL_MODE=block

# Minimum confidence (0.0 - 1.0) to trigger blocking.
MITHRIL_THRESHOLD=0.7

# SQLite database for event logging.
MITHRIL_DB_PATH=mithril.db

# ---------------------------------------------------------------------------
# LLM judge (v0.2) — second-opinion model for ambiguous prompts.
# Disabled by default. When on, the judge only runs when the regex score
# falls between LOW_THRESHOLD and HIGH_THRESHOLD — typically <5% of traffic.
# ---------------------------------------------------------------------------

MITHRIL_JUDGE_ENABLED=false

# Provider. "openai_compat" speaks /v1/chat/completions and works with OpenAI,
# Together, Groq, Fireworks, Ollama, vLLM, LM Studio, llama.cpp, and the
# Anthropic OpenAI-compatibility shim.
MITHRIL_JUDGE_PROVIDER=openai_compat
MITHRIL_JUDGE_BASE_URL=https://api.openai.com/v1
MITHRIL_JUDGE_MODEL=gpt-4o-mini
MITHRIL_JUDGE_API_KEY=

# Ambiguous zone — judge runs only when LOW < score < HIGH.
MITHRIL_JUDGE_LOW_THRESHOLD=0.2
MITHRIL_JUDGE_HIGH_THRESHOLD=0.9

# What to do if the judge errors out: "open" = trust regex, "closed" = block.
MITHRIL_JUDGE_FAIL_MODE=open

MITHRIL_JUDGE_TIMEOUT=5.0
