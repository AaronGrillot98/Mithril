# Upstream LLM provider — what Mithril forwards safe requests to.
# Examples:
#   OpenAI:        https://api.openai.com/v1
#   Anthropic:     https://api.anthropic.com/v1
#   Ollama:        http://localhost:11434/v1
#   Together AI:   https://api.together.xyz/v1
MITHRIL_UPSTREAM_URL=https://api.openai.com/v1

# Bind address and port for the proxy.
MITHRIL_HOST=0.0.0.0
MITHRIL_PORT=8080

# What to do when a request is flagged: "block" (return 403) or "log" (forward but record).
MITHRIL_MODE=block

# Minimum confidence (0.0 - 1.0) to trigger blocking.
MITHRIL_THRESHOLD=0.7

# SQLite database for event logging.
MITHRIL_DB_PATH=mithril.db
